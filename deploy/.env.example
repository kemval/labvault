# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored:
# secrets live only there (or in the host's secret store), never in the repo.

# ── HTTPS ───────────────────────────────────────
# A DNS name pointing at this VM (a free DuckDNS name works).
LABVAULT_DOMAIN=labvault.example.org

# ── App (README, Configuration) ─────────────────
# Secure mode: leave LABVAULT_DEMO_MODE unset in production.
LABVAULT_ADMIN_PASSWORD=change-me-at-least-12-chars

# ── Continuous backup (docs/operations/durable-storage.md) ──
LITESTREAM_REPLICA_URL=s3://labvault-backups/prod
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com and region "auto".
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
